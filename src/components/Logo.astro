---
/**
 * The delv. wordmark, from public/brand/delv-logo.svg.
 *
 * Inlined rather than loaded as an <img> for one reason: the supplied file
 * paints the letterforms in --ink, which is invisible on the site's deep
 * bands. Inline, they take `currentColor`, so the same mark serves the header
 * in ink and the footer in white without a second file to keep in step.
 *
 * The dot reads from --logo-dot, so its colour is a one-line change. It
 * defaults to the aquamarine in the supplied file.
 *
 * The viewBox crops the supplied file's left side bearing, 28.9 units of
 * empty space before the 'd'. Left in, it pushed the painted mark about 6px
 * right of the page's left margin, which is visible against the text below it.
 * The right bearing stays: nothing aligns to that edge.
 *
 * The `.logo-ring` at the end is the shape the dot opens into in the header.
 * It is invisible at rest and only the header animates it, so the footer mark
 * is unchanged; the geometry and the reasoning are in global.css.
 *
 * Decorative here: the link or heading around it carries the accessible name.
 */
interface Props {
  /** Rendered width. Height follows the 468.85:200 ratio. */
  width?: number;
  class?: string;
}
const { width = 96, class: className } = Astro.props;
---

<svg
  class:list={['logo-mark', className]}
  viewBox="28.9 0 439.95 200"
  width={width}
  height={Math.round((width * 200) / 439.95)}
  role="presentation"
  aria-hidden="true"
  focusable="false"
