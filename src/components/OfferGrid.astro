---
import type { MarkKind, Offer } from '../data/types';
import Mark from './graphics/Mark.astro';

interface Props {
  items: Offer[];
  /** Graphic 06, one mark per offer, in the order the offers are written. */
  marks?: readonly MarkKind[];
  class?: string;
}
const { items, marks, class: className } = Astro.props;
---

<div class:list={['offer', items.length === 2 && 'offer--pair', className]}>
  {
    items.map((offer, index) => (
      <div>
        {marks?.[index] && <Mark kind={marks[index]} class="offer-mark" />}
        <h3>{offer.heading}</h3>
        <span class="meta" set:html={offer.meta} />
        <p set:html={offer.body} />
        {offer.action && (
          <p class="offer-action">
            <a href={offer.action.href}>{offer.action.label}</a>
          </p>
        )}
      </div>
    ))
  }
</div>
