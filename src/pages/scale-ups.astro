---
/**
 * Scale-ups.
 *
 * The page is a block list in src/content/pages/scale-ups.json, rendered in
 * the order that file gives. There is no layout here any more, deliberately:
 * Sam edits the copy and the order of the sections himself, and a template
 * that also carried structure would drift out of step with the content the
 * moment he moved one.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';

const page = await getEntry('pages', 'scale-ups');
if (!page) throw new Error('Missing content: src/content/pages/scale-ups.json');
const { meta, blocks } = page.data;
---

<Base
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  noindex={meta.noindex}
>
  <Blocks blocks={blocks} />
</Base>
