---
import Header from '../components/Header.astro';
import Intro from '../components/Intro.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Keeps /404 out of search results without touching robots.txt. */
  noindex?: boolean;
  /** JSON-LD, home page only. */
  jsonLd?: Record<string, unknown>;
  /**
   * Marks a page that carries the growth narrative. It stills the section
   * graphics: a continuous scroll-linked layer and five graphics looping on
   * their own timers are two motion systems competing for the same attention.
   */
  narrative?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/home.png',
  noindex = false,
  jsonLd,
  narrative = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="delv." />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#F7F7F3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/*
      The two faces that set the largest text above the fold: the heading and
      the lede. Archivo is deliberately not preloaded. It only sets nav links
      and buttons here, its fallback is metric-matched so nothing shifts when
      it arrives, and a third preload would put 90kb in front of the LCP for
      14.5px of navigation. The latin-ext subsets load on demand; nothing in
      the site's own copy needs them.
    */}
    <link
      rel="preload"
      href="/fonts/ebgaramond-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline>
      /*
       * Runs before the body paints, so the overlay is never shown to someone
       * who should not see it. Three ways out: already seen this session,
       * reduced motion, or storage unavailable.
       *
       * REPLAY_EVERY_VISIT is Sam's, 13 Sep 2026: while the site is on a test
       * domain with no traffic he wants the animation on every load rather
       * than once a session. SET IT BACK TO false BEFORE LAUNCH. It is the
       * only thing that changes; Intro.astro still records the visit on every
       * play, so flipping this one boolean restores the original behaviour
       * exactly, with no other edit anywhere.
       *
       * Reduced motion is not part of it and never will be. That is an
       * accessibility guarantee, not a preference about how often to show a
       * brand animation.
       *
       * The timeout is a dead man's switch: this attribute also locks body
       * scroll, so if the module script never arrives the page would be stuck.
       * The component takes ownership of it the moment the animation actually
       * starts, because the clock here begins at page load while the animation
       * waits on the font. On a slow connection the two drift apart and this
       * would otherwise cut the animation off part-way through.
       */
      var REPLAY_EVERY_VISIT = true; /* SET TO false BEFORE LAUNCH */

      try {
        var seen =
          !REPLAY_EVERY_VISIT &&
          sessionStorage.getItem('delv:intro') === 'seen';

        if (!seen && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.setAttribute('data-intro', 'play');
          window.__delvIntroGuard = setTimeout(function () {
            document.documentElement.removeAttribute('data-intro');
          }, 8000);
        }
      } catch (e) {
        /* Storage or matchMedia unavailable. The intro simply does not play. */
      }
    </script>

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>

  <body>
    <Intro />
    <a class="skip ui" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" data-narrative={narrative ? '' : undefined}>
      <slot />
    </main>
    <Footer />

    <script>
      /*
       * Reveal blocks as they scroll in.
       *
       * The class that hides them is added here, by script, and only when the
       * reader has not asked for reduced motion and the browser has an
       * IntersectionObserver. Every other case never sees the hidden state at
       * all: no JavaScript, old browser, reduced motion, all get the finished
       * page. Nothing on this site is ever waiting on an animation to appear.
       */
      const canMove =
        window.matchMedia('(prefers-reduced-motion: no-preference)').matches &&
        'IntersectionObserver' in window;

      if (canMove) {
        // Direct children of a band, plus the section rules. The hero is left
        // alone: it has the claim demo, and that is enough happening at once.
        const blocks = document.querySelectorAll(
          '.band > .wrap > *, .cta-band > .wrap > *, main > .wrap > .rule',
        );

        // A three-up reveals column by column rather than as one slab.
        const isGrid = (el: Element) =>
          el.matches('.pillars, .proof, .offer, .people');

        const targets: Element[] = [];
        for (const block of blocks) {
          const group = isGrid(block) ? [...block.children] : [block];
          group.forEach((el, i) => {
            el.classList.add('will-reveal');
            if (i) (el as HTMLElement).style.setProperty('--d', `${i * 80}ms`);
            targets.push(el);
          });
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.04 },
        );

        for (const el of targets) io.observe(el);

        /*
         * The section graphics run on their own loops, and they start on
         * sight rather than at load so a reader meets the beginning of a
         * cycle rather than the middle of one. The paused class is added
         * here and removed here, so a page where this never runs has
         * nothing paused: the graphics simply animate from the start.
         */
        const graphics = document.querySelectorAll('.gfx');
        if (graphics.length) {
          const gio = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.remove('gfx-idle');
                gio.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -5% 0px', threshold: 0.02 },
          );

          for (const el of graphics) {
            el.classList.add('gfx-idle');
            gio.observe(el);
          }
        }

        /*
         * The logo dot, on arrival and on hover.
         *
         * Every link on this site is a full page load, so an animation
         * started on click is cut off wherever the next page happens to
         * paint: 80ms on a warm cache, two seconds on a cold connection.
         * Running it as the new header lands is the same event from the
         * reader's side and is the same length every time.
         *
         * Back and forward restore from bfcache rather than re-parsing, so
         * this does not replay on those, which is the behaviour we want.
         *
         * The class is removed when the animation ends so hover can re-arm
         * it. Listening on the ring alone keeps that deterministic; both
         * shapes finish at their resting values, so a cancelled frame would
         * be invisible either way.
         */
        const logo = document.querySelector('.site-header .logo');
        const ring = logo?.querySelector('.logo-ring');

        if (logo && ring) {
          const mark = () => {
            logo.classList.remove('is-marking');
            /* Forces the style flush that lets the class take twice. */
            void (logo as HTMLElement).offsetWidth;
            logo.classList.add('is-marking');
          };

          ring.addEventListener('animationend', () =>
            logo.classList.remove('is-marking'),
          );
          logo.addEventListener('mouseenter', mark);
          logo.addEventListener('focus', mark);

          /*
           * On a page where the intro plays, the overlay is over the header
           * for its whole run. The claim demo waits the same way.
           */
          if (document.documentElement.hasAttribute('data-intro')) {
            const poll = window.setInterval(() => {
              if (document.documentElement.hasAttribute('data-intro')) return;
              window.clearInterval(poll);
              mark();
            }, 120);
          } else {
            mark();
          }
        }

        /*
         * On a narrative page the section graphics keep their geometry and
         * lose their loops. Sam's call, 15 Sep 2026: a continuous scroll-linked
         * layer and five graphics looping on their own timers are two motion
         * systems competing for the same attention.
         *
         * getAnimations() rather than CSS, because Absorption drives itself
         * with element.animate() and a Web Animations animation ignores
         * animation-play-state entirely. And each one is seeked before it is
         * paused: a loop stopped wherever it happened to be is an arbitrary
         * frame, not a resting state. 0.86 of the cycle is past the last
         * mark's arrival in every one of the five, so what is left on screen
         * is the state each graphic was working towards.
         *
         * Deferred a frame because Absorption starts its animations from its
         * own module script, which may not have run when this one does.
         */
        const narrative = document.querySelector('[data-narrative]');
        if (narrative) {
          /*
           * Selected by exclusion rather than by class. `.gfx` looked like the
           * handle and was not: the three stage marks on the home page carry
           * `gfx-stage` with no `.gfx` ancestor, so a `[data-narrative] .gfx`
           * selector matched nothing and left them looping.
           *
           * Three things are deliberately spared. The claim demo is the one
           * animation the site has always had and the reason the home page
           * works. The narrative layer's own beats are the thing being built.
           * And CSS transitions are not loops at all — the scroll reveals are
           * transitions, and pausing one leaves a block half-faded forever.
           */
          const spared = (el: Element) =>
            el.closest('[data-claim], [data-narr]') !== null;

          const still = () => {
            for (const anim of narrative.getAnimations({ subtree: true })) {
              if (typeof CSSTransition !== 'undefined' && anim instanceof CSSTransition) {
                continue;
              }
              const target = anim.effect && 'target' in anim.effect ? anim.effect.target : null;
              if (!(target instanceof Element) || spared(target)) continue;

              const dur = Number(anim.effect?.getComputedTiming().duration) || 0;
              if (dur) anim.currentTime = dur * 0.86;
              anim.pause();
            }
          };
          requestAnimationFrame(() => requestAnimationFrame(still));
          /* Anything that starts late — a font-driven relayout, a second
             observer — is caught on the next settled frame. */
          window.setTimeout(still, 1200);
        }

        document.documentElement.setAttribute('data-motion', '');
      }

      /*
       * The Who we help group: a disclosure button and a panel.
       *
       * Pointer hover opens it on the desktop bar and the script sets
       * aria-expanded when it does, so what a screen reader is told and what is
       * on screen never disagree. Inside the mobile menu the panel is in the
       * flow and hover is meaningless, so the pointer handlers check the
       * breakpoint rather than being bound only once.
       */
      const wideNav = window.matchMedia('(min-width: 861px)');

      for (const group of document.querySelectorAll<HTMLElement>(
        '[data-nav-group]',
      )) {
        const button = group.querySelector<HTMLButtonElement>(
          '.nav-group-toggle',
        );
        const panel = group.querySelector<HTMLElement>('.nav-panel');
        if (!button || !panel) continue;

        /*
         * Hover peeks, a click holds it open. Without the distinction the two
         * fight: a pointer user hovers, the panel opens, they click the thing
         * they are pointing at, and a plain toggle reads the panel as already
         * open and shuts it in their face.
         */
        let pinned = false;

        const setOpen = (open: boolean) => {
          panel.hidden = !open;
          button.setAttribute('aria-expanded', open ? 'true' : 'false');
        };
        const close = () => {
          pinned = false;
          setOpen(false);
        };

        button.addEventListener('click', () => {
          if (wideNav.matches) {
            pinned = !pinned;
            setOpen(pinned);
          } else {
            setOpen(panel.hidden);
          }
        });

        // Escape closes and puts focus back on the button, so a keyboard user
        // is never left inside a panel that is no longer visible.
        group.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || panel.hidden) return;
          close();
          button.focus();
        });

        // Tabbing out of the group closes it. focusout fires before the new
        // element is focused, so the check is deferred a tick.
        group.addEventListener('focusout', () => {
          setTimeout(() => {
            if (!group.contains(document.activeElement)) close();
          }, 0);
        });

        group.addEventListener('mouseenter', () => {
          if (wideNav.matches && !pinned) setOpen(true);
        });
        group.addEventListener('mouseleave', () => {
          if (wideNav.matches && !pinned) setOpen(false);
        });

        // A click anywhere else closes it, which is what a pointer user
        // expects and what keyboard users get from focusout.
        document.addEventListener('click', (event) => {
          if (panel.hidden) return;
          if (!group.contains(event.target as Node)) close();
        });

        // Crossing the breakpoint with the panel open would leave an accordion
        // expanded inside a closed menu, or a floating panel with no anchor.
        wideNav.addEventListener('change', close);
      }

      // The mobile nav toggle.
      const toggle = document.getElementById('menuToggle');
      const nav = document.getElementById('mainnav');

      if (toggle && nav) {
        const setOpen = (open: boolean) => {
          nav.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        };

        toggle.addEventListener('click', () => {
          setOpen(!nav.classList.contains('open'));
        });

        // Escape closes it and puts focus back where it came from, so a
        // keyboard user is not stranded inside a closed menu.
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.classList.contains('open')) {
            setOpen(false);
            toggle.focus();
          }
        });

        // Widening past the breakpoint reveals the desktop nav; the open
        // class would otherwise linger and leave aria-expanded lying.
        wideNav.addEventListener('change', (event) => {
          if (event.matches) setOpen(false);
        });
      }
    </script>

    {/* Analytics (§2) is Plausible, cookieless, and goes in once Sam
        confirms. Nothing is loaded here in the meantime. */}
  </body>
</html>
