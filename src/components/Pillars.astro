---
import type { Pillar } from '../data/types';
import StageMark from './graphics/StageMark.astro';

interface Props {
  items: Pillar[];
  /**
   * Graphic 03. One shape per pillar, on a shared cycle: a boundary closes, a
   * scale is laid across it, and it resolves into a claim with two smaller
   * restatements. The shapes carry no words of their own, because the pillar
   * underneath each one already has the words.
   */
  marks?: boolean;
}
const { items, marks = false } = Astro.props;

const kinds = ['define', 'measure', 'articulate'] as const;
---

<div class="pillars">
  {
    items.map((pillar, index) => (
      <div class="pillar">
        {marks && kinds[index] && <StageMark kind={kinds[index]} />}
        <span class="step">{pillar.step}</span>
        <h3>{pillar.heading}</h3>
        <p set:html={pillar.body} />
      </div>
    ))
  }
</div>
