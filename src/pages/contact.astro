---
/**
 * The page is a block list in src/content/pages/contact.json, rendered in
 * the order that file gives. See src/content.config.ts.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';

const page = await getEntry('pages', 'contact');
if (!page) throw new Error('Missing content: src/content/pages/contact.json');
const { meta, blocks } = page.data;
---

<Base
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  noindex={meta.noindex}
>
  <Blocks blocks={blocks} />
</Base>
