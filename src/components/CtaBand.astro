---
import type { CtaBand } from '../data/types';

interface Props {
  cta: CtaBand;
}
const { cta } = Astro.props;
---

<div class="dark cta-band">
  <div class="wrap">
    <h2 set:html={cta.heading} />
    {cta.body && <p set:html={cta.body} />}
    <p class="mt-cta">
      <a class="btn" href={cta.action.href}>{cta.action.label}</a>
    </p>
  </div>
</div>
