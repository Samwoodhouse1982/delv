---
/**
 * Moved here from src/data/who-we-are.ts when the pages became content
 * collections and that file went. The shape is the component's, not a page's.
 */
export interface BenchMember {
  /** Omit until there is a real person who has agreed to be named. */
  name?: string;
  /** The discipline. Doubles as the heading when there is no name. */
  role: string;
  /** One sentence: what they are brought in for. */
  body: string;
}

interface Props {
  members: BenchMember[];
}
const { members } = Astro.props;
---

{
  members.length > 0 && (
    <div class="stage bench">
      {members.map((member) => (
        <div class="stage-row">
          <div>
            {/*
              h3 under the section's h2. A member with no name is headed by
              their discipline, so the row never renders an empty heading.
            */}
            <h3>{member.name ?? member.role}</h3>
            {member.name && <span class="when">{member.role}</span>}
          </div>
          <p set:html={member.body} />
        </div>
      ))}
    </div>
  )
}
