---
import Base from '../layouts/Base.astro';
import ClaimDemo from '../components/ClaimDemo.astro';
import Narrative from '../components/Narrative.astro';
import CtaBand from '../components/CtaBand.astro';
import Pillars from '../components/Pillars.astro';
import ProblemList from '../components/ProblemList.astro';
import Quote from '../components/Quote.astro';
import Results from '../components/Results.astro';
import Rule from '../components/Rule.astro';
import Absorption from '../components/graphics/Absorption.astro';
import { site } from '../data/site';
import Figure from '../components/Figure.astro';
import { claim, cta, hero, meta, problems, stages, table, tableImage, what } from '../data/home';
import { placement, quoteFor, resultsFor } from '../data/proof';

// Empty until there is proof to publish, and both bands render nothing when
// they are. See src/data/proof.ts.
const proofResults = resultsFor('home');
const proofQuote = quoteFor('home');
const proofCopy = placement.home;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.company.legalName,
  alternateName: 'delv.',
  url: Astro.site?.href,
  logo: new URL('/og/home.png', Astro.site).href,
  description: site.blurb,
  email: site.email,
  ...(site.sameAs.length > 0 ? { sameAs: site.sameAs } : {}),
};
---

<Base
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  jsonLd={jsonLd}
  narrative
>
  {/*
    The growth-narrative stage: the run of sections the drawing spans, beats 1
    to 3. It is a wrapper rather than a class on <main> because the narrative
    stops at the problems band for now, and a stage that ended where the page
    ended would stretch three beats over six sections.
  */}
  <div class="narr-stage" data-narr-stage>
    <Narrative />

  <div class="wrap hero">
    <h1 class="h1-lockup" set:html={hero.heading} />
    <p class="sub" set:html={hero.sub} />
    <div class="hero-actions">
      {
        hero.actions?.map((action) => (
          <a class:list={['btn', action.ghost && 'btn--ghost']} href={action.href}>
            {action.label}
          </a>
        ))
      }
    </div>
    <ClaimDemo claim={claim} />
  </div>

  <div class="wrap"><Rule /></div>

  <div class="band dark">
    <div class="wrap">
      <div class="split">
        <div><h2>{what.heading}</h2></div>
        <div>
          {what.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
          <p class="muted" set:html={what.muted} />
        </div>
      </div>
      <Absorption class="mt-block" />
    </div>
  </div>

  <div class="band mint">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(28px,3vw,44px)">
        <h2>{problems.heading}</h2>
        <p class="muted" style="margin:0" set:html={problems.lede} />
      </div>
      <ProblemList items={problems.items} />
    </div>
  </div>
  </div>

  <div class="band dim band--tight">
    <div class="wrap">
      <div class="split" style="margin-bottom:28px">
        <h2>{stages.heading}</h2>
        <p class="muted" style="margin:0" set:html={stages.lede} />
      </div>
      <Pillars items={stages.pillars} shapes />
      <p class="mt-cta">
        <a class="btn btn--ghost" href={stages.action.href}>{stages.action.label}</a>
      </p>
    </div>
  </div>

  {
    proofResults.length > 0 && (
      <div class="band">
        <div class="wrap">
          <div class="split" style="margin-bottom:clamp(28px,3vw,44px)">
            <h2>{proofCopy.heading}</h2>
            {proofCopy.lede && (
              <p class="muted" style="margin:0" set:html={proofCopy.lede} />
            )}
          </div>
          <Results items={proofResults} />
        </div>
      </div>
    )
  }

  <div class="band">
    <div class="wrap split">
      <div>
        <h2>{table.heading}</h2>
        <Rule short class="mt-rule" />
        <Figure figure={tableImage} class="mt-block" />
      </div>
      <div>
        {table.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
        <p>
          <a class="btn btn--ghost" href={table.action.href}>{table.action.label}</a>
        </p>
      </div>
    </div>
  </div>

  {
    proofQuote && (
      <div class="band band--tight dim">
        <div class="wrap">
          <Quote quote={proofQuote} />
        </div>
      </div>
    )
  }

  <CtaBand cta={cta} />
</Base>
