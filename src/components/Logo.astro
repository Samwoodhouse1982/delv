    <!--
      The ring the dot opens into, concentric with it and invisible at rest.
      Geometry taken from the dot path's own bounding box: centre (443.1,
      180.2), radius 15.7. `non-scaling-stroke` takes the width out of the
      transform chain, so stroke-width is screen pixels rather than the 0.2px
      per unit this viewBox renders at: the ring stays a hairline at every
      scale, the same weight as the rules elsewhere on the page.
      Only the header animates it; in the footer it sits at opacity 0.
    -->
    <circle
      class="logo-ring"
      cx="443.1"
      cy="180.2"
      r="15.7"
      fill="none"
      stroke="var(--logo-dot, #16f4d0)"
      stroke-width="1.2"
      vector-effect="non-scaling-stroke"
    />
</svg>
