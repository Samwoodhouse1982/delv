---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import DetailList from '../components/DetailList.astro';
import Note from '../components/Note.astro';
import Pillars from '../components/Pillars.astro';
import Rule from '../components/Rule.astro';
import StageList from '../components/StageList.astro';
import { cta, hero, meta, moments, outcome, where } from '../data/for-startups';
---

<Base title={meta.title} description={meta.description} ogImage={meta.ogImage}>
  <div class="wrap hero">
    <h1>{hero.heading}</h1>
    <p class="sub" set:html={hero.sub} />
  </div>

  <div class="wrap"><Rule /></div>

  <div class="band">
    <div class="wrap">
      <h2 style="max-width:20ch">{moments.heading}</h2>
      <StageList rows={moments.rows} class="mt-block" />
    </div>
  </div>

  <div class="band dim">
    <div class="wrap">
      <div class="split" style="margin-bottom:30px">
        <h2>{where.heading}</h2>
        <p class="muted" style="margin:0" set:html={where.lede} />
      </div>
      <Pillars items={where.pillars} />
    </div>
  </div>

  <div class="band">
    <div class="wrap split">
      <div>
        <h2>{outcome.heading}</h2>
        <Rule short class="mt-rule" />
      </div>
      <div>
        <DetailList items={outcome.details} />
        <Note text={outcome.note} />
      </div>
    </div>
  </div>

  <CtaBand cta={cta} />
</Base>
