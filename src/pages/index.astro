---
/**
 * Home.
 *
 * The page is a block list in src/content/pages/index.json, rendered in the
 * order that file gives. See src/content.config.ts for the block schema and
 * why the layout moved into the content.
 *
 * The JSON-LD stays here: it is structured data about the organisation for
 * search engines, not page content, and nothing in the CMS should be able to
 * change what the site claims to be.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import { site } from '../data/site';

const page = await getEntry('pages', 'index');
if (!page) throw new Error('Missing content: src/content/pages/index.json');
const { meta, blocks } = page.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.company.legalName,
  alternateName: 'delv.',
  url: Astro.site?.href,
  logo: new URL('/og/home.png', Astro.site).href,
  description: site.blurb,
  email: site.email,
  ...(site.sameAs.length > 0 ? { sameAs: site.sameAs } : {}),
};
---

<Base
  title={meta.title}
  description={meta.description}
  ogImage={meta.ogImage}
  jsonLd={jsonLd}
>
  <Blocks blocks={blocks} />
</Base>
