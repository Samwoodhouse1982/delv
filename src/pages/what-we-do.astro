---
import Base from '../layouts/Base.astro';
import DetailList from '../components/DetailList.astro';
import Rule from '../components/Rule.astro';
import Figure from '../components/Figure.astro';
import { closing, hero, meta, stageImage, stages } from '../data/what-we-do';
---

<Base title={meta.title} description={meta.description} ogImage={meta.ogImage}>
  <div class="wrap hero">
    <h1>{hero.heading}</h1>
    <p class="sub" set:html={hero.sub} />
  </div>

  <div class="wrap"><Rule /></div>

  {
    stages.map((stage, index) => (
      <div class:list={['band', index === 1 && 'dim']}>
        <div class="wrap split">
          <div>
            <span class="stage-label ui">{stage.label}</span>
            <h2>{stage.heading}</h2>
            <p class="lede mt-lede" set:html={stage.lede} />
          </div>
          <div>
            {stage.paragraphs.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
            <DetailList items={stage.details} />
            {index === 1 && <Figure figure={stageImage} class="mt-block" />}
          </div>
        </div>
      </div>
    ))
  }

  <div class="band dark band--tight">
    <div class="wrap">
      <h2 style="max-width:20ch">{closing.heading}</h2>
      <p style="margin-top:18px;max-width:54ch" set:html={closing.body} />
      <p class="mt-cta">
        <a class="btn" href={closing.action.href}>{closing.action.label}</a>
      </p>
    </div>
  </div>
</Base>
