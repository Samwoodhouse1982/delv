---
/**
 * The delv. intro, ported from the design handoff in
 * design_handoff_delv_intro/ (README.md has the timing table and geometry).
 *
 * The handoff ships a React component; this is the same piece in vanilla, to
 * the same numbers. Everything visible is a pure function of elapsed seconds,
 * exactly as the handoff specifies, so there is no state beyond the clock.
 *
 * It does not play for everyone. A blocking script in the document head, in
 * Base.astro, decides before the first paint: seen this session, or reduced
 * motion, and the overlay never renders at all. That check has to happen in
 * the head, because deciding later means returning visitors get a flash of
 * the overlay before it is taken away.
 */
const PHRASE = 'deliver value.';
---

<div class="intro" id="intro" aria-hidden="true">
  <div class="intro-stage" id="introStage">
    <div class="intro-zoom" id="introZoom">
      <div class="intro-ground" id="introGround"></div>
      <div class="intro-group" id="introGroup">
        <div class="intro-row" id="introRow">
          {PHRASE.split('').map((c) => <span>{c === ' ' ? ' ' : c}</span>)}
        </div>
      </div>
    </div>
    <div class="intro-hole" id="introHole"></div>
  </div>
  <div class="intro-flash" id="introFlash"></div>
</div>

<script>
  /*
   * Two stages, one piece. Landscape composes on 1600x900 as the handoff
   * specifies; portrait composes on 900x1600 with the phrase broken over two
   * lines, because a 1600-wide stage covering a portrait phone is scaled by
   * its height and the phrase runs off both edges. See the note in the CSS.
   */
  const STAGE = {
    wide: { w: 1600, h: 900 },
    tall: { w: 900, h: 1600 },
  };
  const SIZE = 150;
  const ROW_H = SIZE * 1.2;
  const FONT = `600 ${SIZE}px "EB Garamond", Georgia, serif`;

  const KEEP = new Set([0, 1, 2, 8, 13]);
  const PERIOD = 13;
  /** Where the line breaks in portrait. The space itself takes no width there. */
  const SPACE = 7;

  const CUE = { Arrive: 0, Mark: 1.2, Merge: 2.0, Lock: 3.0, Enter: 4.3 };
  const DURATION = 5.5;
  const GROUND_START = 2400;
  const GROUND_END = 700;
  const DIVE_MAX = 6;
  const HOLE_MAX = 160;

  const C = {
    ink: [21, 59, 80],
    // The handoff sets the surviving letters to Yale Blue. Pacific Blue
    // #429EA6 -> [66, 158, 166] is the documented alternative.
    accent: [21, 59, 80],
    dot: [22, 244, 208],
  };

  const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
  const easeInOutCubic = (t: number) =>
    t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  const easeOutBack = (t: number) =>
    1 + 2.70158 * Math.pow(t - 1, 3) + 1.70158 * Math.pow(t - 1, 2);
  const easeInQuad = (t: number) => t * t;

  const ramp =
    (ease: (t: number) => number) => (start: number, end: number) => (T: number) =>
      ease(clamp((T - start) / (end - start), 0, 1));
  const enter = ramp(easeOutCubic);
  const collapse = (s: number, e: number) => {
    const f = ramp(easeInOutCubic)(s, e);
    return (T: number) => 1 - f(T);
  };
  const pop = ramp(easeOutBack);
  const dive = ramp(easeInQuad);

  const mix = (A: number[], B: number[], t: number) =>
    A.map((v, i) => v + (B[i] - v) * clamp(t, 0, 1));
  const rgb = (c: number[]) => `rgb(${c.map(Math.round).join(',')})`;

  declare global {
    interface Window {
      __delvIntroGuard?: ReturnType<typeof setTimeout>;
    }
  }

  const overlay = document.getElementById('intro');
  const root = document.documentElement;

  const finish = () => {
    root.removeAttribute('data-intro');
    overlay?.remove();
  };

  if (overlay && root.getAttribute('data-intro') === 'play') {
    const stage = document.getElementById('introStage')!;
    const zoom = document.getElementById('introZoom')!;
    const ground = document.getElementById('introGround')!;
    const group = document.getElementById('introGroup')!;
    const row = document.getElementById('introRow')!;
    const hole = document.getElementById('introHole')!;
    const flash = document.getElementById('introFlash')!;
    const spans = Array.from(row.children) as HTMLElement[];
    const chars = spans.map((s) => s.textContent!.replace(' ', ' '));

    /*
     * Portrait gets the tall stage and two lines. The test is the viewport's
     * own shape rather than a width breakpoint, because the problem is an
     * aspect ratio: a tablet held upright at 768x1024 crops the phrase just
     * as a phone does, and a phone turned sideways does not.
     */
    const twoLine = () => innerHeight > innerWidth;

    let stageW = STAGE.wide.w;
    let stageH = STAGE.wide.h;

    const fit = () => {
      const { w, h } = twoLine() ? STAGE.tall : STAGE.wide;
      stageW = w;
      stageH = h;
      const shell = stage.parentElement as HTMLElement;
      shell.style.setProperty('--intro-stage-w', `${w}px`);
      shell.style.setProperty('--intro-stage-h', `${h}px`);
      stage.style.setProperty(
        'transform',
        `scale(${Math.max(innerWidth / w, innerHeight / h)})`,
      );
    };
    fit();

    /*
     * Measure only once the real font is in. The handoff is explicit about
     * why: a fallback first frame gives different advance widths, so every
     * letter jumps sideways the moment EB Garamond swaps in. The face is
     * already preloaded in the head, so this resolves immediately from cache.
     */
    const measure = () => {
      const ctx = document.createElement('canvas').getContext('2d')!;
      ctx.font = FONT;
      const w = chars.map((c) => ctx.measureText(c).width);
      const d = ctx.measureText('.');
      const inkAsc = d.actualBoundingBoxAscent;
      const inkDesc = d.actualBoundingBoxDescent;
      const fAsc = d.fontBoundingBoxAscent;
      const fDesc = d.fontBoundingBoxDescent;
      const baselineFromTop = (ROW_H - (fAsc + fDesc)) / 2 + fAsc;
      return {
        w,
        dotSize: inkAsc + inkDesc,
        dotCenterFromPen: (d.actualBoundingBoxRight - d.actualBoundingBoxLeft) / 2,
        dotCenterY: baselineFromTop - ROW_H / 2 + (inkDesc - inkAsc) / 2,
      };
    };

    /**
     * Where every character starts and where it ends, in stage pixels about
     * the row's centre.
     *
     * The whole merge is one interpolation between the two. `end` is always
     * "delv." on a single line: each kept character at the running total of
     * the kept widths before it, each dropped one at the same place as the
     * kept character that follows it, which is where they were going anyway
     * and where they are invisible by the time they arrive.
     *
     * `start` is the phrase as written. On one line that is the running total
     * of every width, and the vertical term is zero from beginning to end, so
     * the motion is exactly the horizontal collapse it has always been. On two
     * it is each line's own running total, one line above the centre and one
     * below, and the vertical term closes as the horizontal one does: the two
     * lines come together into the one line "delv." lands on.
     *
     * Both layouts are centred on zero by construction. The old code centred
     * the full phrase by flow and then translated the group back by half the
     * dropped width to re-centre what was left; this needs no such correction,
     * and the two are provably the same for every character and every frame.
     */
    const plan = (W: number[], two: boolean) => {
      const sum = (ns: number[]) => ns.reduce((a, b) => a + b, 0);
      const startX: number[] = [];
      const startY: number[] = [];
      const endX: number[] = [];

      const keptW = sum(W.filter((_, i) => KEEP.has(i)));
      let pen = 0;
      for (let i = 0; i < W.length; i++) {
        endX.push(pen - keptW / 2);
        if (KEEP.has(i)) pen += W[i];
      }

      if (!two) {
        const fullW = sum(W);
        let x = 0;
        for (let i = 0; i < W.length; i++) {
          startX.push(x - fullW / 2);
          startY.push(0);
          x += W[i];
        }
      } else {
        /* The space becomes the line break, so it takes no width. */
        const width = (i: number) => (i === SPACE ? 0 : W[i]);
        const lines = [
          { from: 0, to: SPACE, y: -ROW_H / 2 },
          { from: SPACE + 1, to: W.length - 1, y: ROW_H / 2 },
        ];
        for (const line of lines) {
          let lineW = 0;
          for (let i = line.from; i <= line.to; i++) lineW += width(i);
          let x = 0;
          for (let i = line.from; i <= line.to; i++) {
            startX[i] = x - lineW / 2;
            startY[i] = line.y;
            x += width(i);
          }
        }
      }
      return { startX, startY, endX };
    };

    const run = (M: ReturnType<typeof measure>) => {
      const W = M.w;
      let at = plan(W, twoLine());

      // Fixed measured widths, set once. Animating width would reflow the row
      // every frame, which is what the handoff warns visibly janks.
      spans.forEach((s, i) => {
        s.style.width = `${W[i]}px`;
        /* So a character's transform addresses the centre of its own line
           box, which is the origin the measured dot offset is relative to. */
        s.style.height = `${ROW_H}px`;
        s.style.marginTop = `${-ROW_H / 2}px`;
      });
      overlay.classList.add('is-ready');

      /*
       * A rotation mid-play changes the stage, and with it which layout the
       * characters are flying between. Recomputing is fourteen additions, and
       * the frame after it puts everything where the new plan says, so the
       * piece carries on rather than finishing off the side of the screen.
       */
      const onResize = () => {
        fit();
        at = plan(W, twoLine());
      };
      addEventListener('resize', onResize, { passive: true });

      const collapseW = collapse(CUE.Merge, CUE.Merge + 0.85);
      const fadeOut = collapse(CUE.Merge, CUE.Merge + 0.36);

      let raf = 0;
      let ended = false;
      const t0 = performance.now();

      const frame = (T: number) => {
        const mark = enter(CUE.Mark, CUE.Mark + 0.55)(T);
        const dotPop =
          pop(CUE.Lock - 0.1, CUE.Lock + 0.3)(T) *
          (1 - enter(CUE.Lock + 0.3, CUE.Lock + 0.62)(T));
        const push = enter(CUE.Merge, CUE.Enter + 0.2)(T);
        const shrink = collapse(CUE.Merge + 0.25, CUE.Enter - 0.05)(T);
        const cool = enter(CUE.Merge + 0.5, CUE.Lock + 0.05)(T);
        const diveP = dive(CUE.Enter, CUE.Enter + 1.05)(T);
        const land = enter(CUE.Enter + 0.98, CUE.Enter + 1.2)(T);

        const groupScale = 1 + 0.17 * push;
        const prog = 1 - collapseW(T);

        /* Where a character is now: its start, moved towards its end. */
        const px = (i: number) => at.startX[i] + (at.endX[i] - at.startX[i]) * prog;
        const py = (i: number) => at.startY[i] * (1 - prog);

        const dotX =
          stageW / 2 + groupScale * (px(PERIOD) + M.dotCenterFromPen);
        const dotY = stageH / 2 + groupScale * (py(PERIOD) + M.dotCenterY);
        const holeSize = M.dotSize * groupScale * Math.pow(HOLE_MAX, diveP);
        const groundSize = GROUND_END + (GROUND_START - GROUND_END) * shrink;

        // Scale only, about the full stop's ink centre. Panning to recentre
        // while the zoom is shallow is what made earlier versions lurch.
        zoom.style.transformOrigin = `${dotX}px ${dotY}px`;
        zoom.style.transform = `scale(${Math.pow(DIVE_MAX, diveP)})`;

        ground.style.width = `${groundSize}px`;
        ground.style.height = `${groundSize}px`;
        group.style.transform = `scale(${groupScale})`;

        for (let i = 0; i < spans.length; i++) {
          const s = spans[i];
          const start = CUE.Arrive + 0.05 * i;
          const p = enter(start, start + 0.55)(T);
          let opacity = p;
          let extra = '';

          if (KEEP.has(i)) {
            s.style.color =
              i === PERIOD
                ? rgb(mix(C.ink, C.dot, mark))
                : rgb(mix(mix(C.ink, C.accent, mark), C.ink, cool));
            if (i === PERIOD) extra = ` scale(${1 + 0.22 * dotPop})`;
          } else {
            opacity = p * (1 - 0.66 * mark) * fadeOut(T);
            extra = ` translateY(${12 * (1 - fadeOut(T))}px) scale(${0.5 + 0.5 * fadeOut(T)})`;
          }

          s.style.opacity = String(opacity);
          s.style.transform =
            `translate(${px(i)}px, ${py(i) + (1 - p) * 58}px)` +
            ` rotate(${(1 - p) * -7}deg)${extra}`;
        }

        // A separate disc, starting at the glyph's exact ink diameter in the
        // same place and colour, so it reads as the full stop swallowing the
        // screen. Scaling the live text this far would rasterise badly.
        hole.style.width = `${holeSize}px`;
        hole.style.height = `${holeSize}px`;
        hole.style.left = `${dotX}px`;
        hole.style.top = `${dotY}px`;
        hole.style.marginLeft = `${-holeSize / 2}px`;
        hole.style.marginTop = `${-holeSize / 2}px`;
        hole.style.opacity = diveP > 0 ? '1' : '0';

        flash.style.opacity = String(land);
        if (land > 0) overlay.style.pointerEvents = 'none';
      };

      const end = () => {
        if (ended) return;
        ended = true;
        cancelAnimationFrame(raf);
        clearTimeout(window.__delvIntroGuard);
        removeEventListener('resize', onResize);
        finish();
      };

      const tick = (now: number) => {
        const T = (now - t0) / 1000;
        frame(T);
        if (T >= DURATION) return end();
        raf = requestAnimationFrame(tick);
      };

      frame(0);
      raf = requestAnimationFrame(tick);

      // Not in the handoff, but 5.5 seconds is a long time to hold someone
      // who has arrived to read something. Any key or click ends it.
      addEventListener('keydown', end, { once: true });
      overlay.addEventListener('click', end, { once: true });
    };

    const start = () => {
      try {
        sessionStorage.setItem('delv:intro', 'seen');
      } catch {
        // Private mode. It replays next visit; nothing else breaks.
      }
      /*
       * Take over the head's dead man's switch. Its clock started at page
       * load; ours starts now, after the font resolved. On a slow connection
       * those are seconds apart, and leaving the original running cuts the
       * animation off mid-dive. Reproduced with the font held back 3.5s: the
       * overlay vanished at 8.1s needing until 9.0s.
       */
      clearTimeout(window.__delvIntroGuard);
      window.__delvIntroGuard = setTimeout(finish, (DURATION + 2) * 1000);
      run(measure());
    };

    if (document.fonts) {
      document.fonts
        .load(`600 ${SIZE}px "EB Garamond"`)
        .then(start)
        .catch(start);
    } else {
      start();
    }
  } else {
    finish();
  }
</script>
