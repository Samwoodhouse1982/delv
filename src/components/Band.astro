---
/**
 * The ground a block sits on, or nothing at all.
 *
 * Exists so the block renderer never has to write a conditional wrapper
 * around JSX. `band: "none"` renders the children straight into the page
 * flow, which is what the hero, the rules, the claim demo and the closing
 * band need.
 */
interface Props {
  band: 'paper' | 'linen' | 'mint' | 'deep' | 'none';
  tight?: boolean;
  /** Suppresses the decorative discs. See the note on `plain` in the schema. */
  plain?: boolean;
}
const { band, tight = false, plain = false } = Astro.props;

const ground = { paper: '', linen: 'dim', mint: 'mint', deep: 'dark', none: '' }[band];
const cls = ['band', tight ? 'band--tight' : '', ground, plain ? 'contact-page' : '']
  .filter(Boolean)
  .join(' ');
---

{band === 'none' ? <slot /> : <div class={cls}><slot /></div>}
