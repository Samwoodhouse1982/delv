---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import DetailList from '../components/DetailList.astro';
import OfferGrid from '../components/OfferGrid.astro';
import QA from '../components/QA.astro';
import Quote from '../components/Quote.astro';
import Rule from '../components/Rule.astro';
import StageList from '../components/StageList.astro';
import Figure from '../components/Figure.astro';
import { cta, engagement, hero, meta, offers, qa, tests, workingImage } from '../data/how-we-work';
import { quoteFor } from '../data/proof';

const proofQuote = quoteFor('how-we-work');
---

<Base title={meta.title} description={meta.description} ogImage={meta.ogImage}>
  <div class="wrap hero">
    <h1>{hero.heading}</h1>
    <p class="sub" set:html={hero.sub} />
  </div>

  <div class="wrap"><Rule /></div>

  <div class="band">
    <div class="wrap">
      <h2 style="max-width:16ch">{engagement.heading}</h2>
      <StageList rows={engagement.rows} class="mt-block" />
      <Figure figure={workingImage} class="mt-block" />
    </div>
  </div>

  <div class="band dim">
    <div class="wrap">
      <div class="split" style="margin-bottom:30px">
        <h2>{offers.heading}</h2>
        <p class="muted" style="margin:0" set:html={offers.lede} />
      </div>
      <OfferGrid items={offers.items} />
    </div>
  </div>

  <div class="band">
    <div class="wrap split">
      <div>
        <h2>{tests.heading}</h2>
        <Rule short class="mt-rule" />
      </div>
      <div>
        <p set:html={tests.lede} />
        <DetailList items={tests.items} />
      </div>
    </div>
  </div>

  <div class="band dim">
    <div class="wrap">
      <h2 style="margin-bottom:26px">{qa.heading}</h2>
      <QA items={qa.items} />
    </div>
  </div>

  {
    proofQuote && (
      <div class="band band--tight">
        <div class="wrap">
          <Quote quote={proofQuote} />
        </div>
      </div>
    )
  }

  <CtaBand cta={cta} />
</Base>
