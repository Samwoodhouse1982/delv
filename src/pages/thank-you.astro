---
import Base from '../layouts/Base.astro';
import Rule from '../components/Rule.astro';
import { getEntry } from 'astro:content';
import { form } from '../data/contact';

/*
 * The "what happens next" list is the contact page's, read from its content
 * entry rather than copied. Two pages promising different things after the
 * same form is exactly the kind of drift this site argues against, and the
 * CMS only edits it in one place.
 */
const contactPage = await getEntry('pages', 'contact');
const next = contactPage?.data.blocks.find((b) => b.type === 'contactForm');
if (!next) throw new Error('contact.json has no contactForm block');
import DetailList from '../components/DetailList.astro';

// Where a submission without JavaScript lands. With JavaScript the form is
// replaced in place and this page is never reached.
---

<Base
  title="Thank you · delv."
  description="Your message has reached us. We reply within two working days."
  noindex
>
  <div class="wrap hero">
    <h1>{form.success.heading}</h1>
  </div>

  <div class="wrap"><Rule /></div>

  <div class="band">
    <div class="wrap split">
      <div>
        <h2 class="as-h3">{next.heading}</h2>
        <DetailList items={next.items} class="mt-rule" />
      </div>
      <div>
        {form.success.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
        <p class="mt-cta"><a class="btn btn--ghost" href="/">Back to the site</a></p>
      </div>
    </div>
  </div>
</Base>
