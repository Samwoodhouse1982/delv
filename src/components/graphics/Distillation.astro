---
/**
 * Graphic 01, Distillation. The home page's illustrative claim.
 *
 * A field of taupe marks, dense at the left and thinning to the right, until
 * one aquamarine point is left inside two rings. It is the claim demo as a
 * picture: activity everywhere on the Before side, one thing worth counting on
 * the After side, and the dashed rule between the two columns is where the
 * field gives out.
 *
 * It renders as a layer behind the claim rather than as a band of its own.
 * Underneath the comparison it was a second telling of the same argument, one
 * band after another; behind it, it is the substrate the argument sits on.
 *
 * The field is generated at build time from a fixed seed, so this ships no
 * JavaScript. The only motion is drift and a breathing ring, both gated in the
 * stylesheet, and both resting in a legible state.
 *
 * Everything about how dark a mark may be is in src/lib/scatter.ts: text sits
 * on top of this, and that sets the ceiling.
 */
import { buildField } from '../../lib/scatter';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const field = buildField();
---

<div class:list={['gfx', 'claim-field', className]} aria-hidden="true">
  {
    field.map((d) => (
      <span
        class="gfx-dot"
        style={`--x:${d.x}%;--y:${d.y}%;--s:${d.s}em;--o:${d.o};--dur:${d.dur}s;--delay:${d.delay}s`}
      />
    ))
  }

  {/*
    The resolution. It sits in the right fifth, which the field deliberately
    leaves empty and the claim text is held clear of, so nothing here can ever
    land on a word.
  */}
  <span
    class="gfx-ring gfx-ring--breathe claim-resolve"
    style="--s:11.19em;--o:0.55"
  ></span>
  <span class="gfx-ring claim-resolve" style="--s:6.44em;--o:0.7"></span>
  <span class="gfx-point claim-resolve" style="--s:2.2em"></span>
</div>
